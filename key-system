-- CONFIGURATION
local Config = {
    ServiceID = "voidhub@bloxfruit",
    DevPass = "ROSEY_OP_DEVELOPER",
    KeyLink = "PASTE_YOUR_PANDA_KEY_LINK_HERE", -- Paste your link here when ready
    TargetScript = "https://raw.githubusercontent.com/Rosey131/rosey-blox-fruit/refs/heads/main/bloxfruit"
}

-- Load WindUI Library
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

-- Load PandaAuth API
local PandaAuth
pcall(function()
    PandaAuth = loadstring(game:HttpGet("https://raw.githubusercontent.com/Panda-Developer/PandaAuth/main/PandaAuth.lua"))()
end)

-- Create Window with Native WindUI KeySystem
local Window = WindUI:CreateWindow({
    Title = "VOID HUB | BLOX FRUIT",
    Icon = "shield-check",
    Author = "ROSEY",
    Folder = "VoidHubConfig",
    Size = UDim2.fromOffset(580, 460),
    Transparent = true,
    Theme = "Dark",
    
    -- Native WindUI Key System Configuration
    KeySystem = {
        Key = { Config.DevPass }, -- Static Dev Pass array
        Note = "Enter Panda Key or Developer Pass to continue.",
        URL = Config.KeyLink,
        SaveKey = true,
        
        -- Custom Validation Hook for PandaAuth
        API = {
            Validate = function(enteredKey)
                -- 1. Validate Developer Pass
                if enteredKey == Config.DevPass then
                    return true
                end
                
                -- 2. Validate PandaAuth System
                if PandaAuth and PandaAuth.ValidateKey then
                    local success, result = pcall(function()
                        return PandaAuth:ValidateKey(Config.ServiceID, enteredKey)
                    end)
                    if success and result then return true end
                end
                
                -- Fallback HTTP API Request
                local success, res = pcall(function()
                    return game:HttpGet("https://api.pandauth.com/v1/authenticate?service=" .. Config.ServiceID .. "&key=" .. enteredKey)
                end)
                if success and res and (res:find("true") or res:find("authenticated")) then
                    return true
                end
                
                return false
            end
        }
    }
})

-- Automatically executed ONLY AFTER Key Verification succeeds:
task.spawn(function()
    -- Destroy the Key System UI completely
    Window:Destroy()
    
    -- Execute Target Script
    loadstring(game:HttpGet(Config.TargetScript))()
end)
