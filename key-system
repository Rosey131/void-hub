-- CONFIGURATION
local Config = {
    ServiceID = "voidhub@bloxfruit",
    DevPass = "ROSEY_OP_DEVELOPER",
    KeyLink = "PASTE_YOUR_PANDA_KEY_LINK_HERE", -- Put your Panda link here when ready
    TargetScript = "https://raw.githubusercontent.com/Rosey131/rosey-blox-fruit/refs/heads/main/bloxfruit"
}

-- Load WindUI
local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

-- Load PandaAuth API safely
local PandaAuth
pcall(function()
    PandaAuth = loadstring(game:HttpGet("https://raw.githubusercontent.com/Panda-Developer/PandaAuth/main/PandaAuth.lua"))()
end)

local enteredKey = ""

-- Create Key Verification Window
local KeyWindow = WindUI:CreateWindow({
    Title = "VOID HUB | KEY SYSTEM",
    Icon = "key-round",
    Author = "ROSEY",
    Folder = "VoidHubKeyConfig",
    Size = UDim2.fromOffset(450, 280),
    Transparent = true,
    Theme = "Dark",
    Resizable = false,
})

local MainTab = KeyWindow:Tab({
    Title = "Authentication",
    Icon = "shield-check",
})

MainTab:Section({ Title = "Key Verification" })

-- Input Field
MainTab:Input({
    Title = "Key Input",
    Placeholder = "Enter Panda Key or Dev Pass...",
    ClearTextOnFocus = false,
    Callback = function(val)
        enteredKey = val
    end,
})

-- Verification Success Handler
local function onValidKey()
    WindUI:Notify({
        Title = "Access Granted",
        Content = "Key verified! Destroying UI and loading script...",
        Duration = 2,
    })
    
    task.wait(1.2)
    
    -- Destroy Key System UI completely
    KeyWindow:Destroy()
    
    -- Execute Blox Fruit Script
    loadstring(game:HttpGet(Config.TargetScript))()
end

-- Submit Key Button
MainTab:Button({
    Title = "Verify Key",
    Icon = "check",
    Callback = function()
        -- 1. Check Developer Pass
        if enteredKey == Config.DevPass then
            onValidKey()
            return
        end

        -- 2. Check PandaAuth Validation
        local isValid = false
        if PandaAuth and PandaAuth.ValidateKey then
            pcall(function()
                isValid = PandaAuth:ValidateKey(Config.ServiceID, enteredKey)
            end)
        else
            -- Direct Fallback HTTP check
            pcall(function()
                local res = game:HttpGet("https://api.pandauth.com/v1/authenticate?service=" .. Config.ServiceID .. "&key=" .. enteredKey)
                if res and (res:find("true") or res:find("authenticated")) then
                    isValid = true
                end
            end)
        end

        if isValid then
            onValidKey()
        else
            WindUI:Notify({
                Title = "Access Denied",
                Content = "Invalid Key or Developer Pass!",
                Duration = 3,
            })
        end
    end,
})

-- Copy Key Link Button
MainTab:Button({
    Title = "Get Panda Key Link",
    Icon = "link",
    Callback = function()
        if Config.KeyLink ~= "PASTE_YOUR_PANDA_KEY_LINK_HERE" then
            if setclipboard then
                setclipboard(Config.KeyLink)
                WindUI:Notify({ Title = "Copied", Content = "Key link copied to clipboard!", Duration = 3 })
            else
                WindUI:Notify({ Title = "Error", Content = "Your executor does not support setclipboard.", Duration = 3 })
            end
        else
            WindUI:Notify({ Title = "Notice", Content = "Replace line 5 with your Panda key link first.", Duration = 3 })
        end
    end,
})
